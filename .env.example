# RAG GT Pipeline — Environment Configuration
# Copy this file to .env and fill in your values.
# This is the ONLY file a user needs to edit.

LLM_BACKEND=api             # "api" | "ollama"

API_BASE_URL=https://your-company-api.example.com/v1
API_KEY=your-api-key-here
API_GT_MODEL=gpt-4o
API_ANSWER_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GT_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_ANSWER_MODEL=qwen2.5:3b-instruct-q4_K_M

NLI_MODEL=cross-encoder/nli-deberta-v3-base

NLI_CACHE_PATH=data/cache/nli_cache.db
CLAIM_CACHE_PATH=data/cache/claim_cache.db
ANSWER_CACHE_PATH=data/cache/answer_cache.db   # NEW in V9 — persistent SQLite answer cache

GT_OUTPUT_DIR=data/gt
RAG_GT_DATA_DIR=                               # optional override for data/ root
EMBED_MODEL=BAAI/bge-base-en-v1.5             # embedding model (V9 vectorstore)
RAG_GT_MAX_CONCURRENT_LLM_CALLS=              # optional override; default 8 (API) / 4 (Ollama)
